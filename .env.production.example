# Ubuntu VM template — outbound traffic must go through the corporate proxy.
USE_PROXY=true
PROXY_URL=http://proxy.internal.example.com:8080

HUAWEI_API_BASE_URL=https://huawei-api.example.com
HUAWEI_CA_CERT_PATH=/etc/backend-soporte/certs/huawei-ca.pem
# Set to false only for diagnostics (e.g. hitting the API by IP instead of hostname).
HUAWEI_VERIFY_SSL=true

REQUEST_TIMEOUT_SECONDS=30
